<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-app: bootstrap and the only deployable artifact (target/mcp-servicedesk.jar). Assembles the hexagon
  and registers the tools; tests run the whole server over HTTP behind the TestGateway of mcp-platform-test.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.aiwcorpo.mcp.servicedesk</groupId>
        <artifactId>mcp-servicedesk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>mcp-app</artifactId>
    <name>mcp-servicedesk :: App (bootstrap)</name>
    <dependencies>
        <dependency><groupId>${project.groupId}</groupId><artifactId>mcp-tools</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>${project.groupId}</groupId><artifactId>mcp-integration</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>pl.aiwcorpo.mcp</groupId><artifactId>mcp-platform-starter</artifactId></dependency>

        <!-- Stands in for the gateway in tests (test JWKS, internal JWTs, C3 headers). Never outside test scope. -->
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-platform-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>mcp-servicedesk</finalName>
        <plugins>
            <!-- Boots the server once more in the package phase, even with -DskipTests, to leave target/mcp-manifest.json
                 for the CI registration step (README, "Manifest i rejestracja"). -Dmaven.test.skip=true skips it too. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>manifest-artifact</id>
                        <phase>package</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                            <test>ManifestArtifactTest</test>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
